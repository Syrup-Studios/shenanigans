{
    "name": "Shenanigans",
    "version": "DEV",
    "release_type": "alpha",
    "description": "This is my attempt on creating a nice and pleasent Vanilla++ Experience with many opiniated changes to make it feel very intuitive and comfortable.",
    "author": "Syrup Studios",
    "overrides": [
        "config",
        "kubejs"
    ],
    "server_overrides": [
        "!kubejs/assets",
        "server.properties",
        "server-icon.png"
    ],
    "client_overrides": [
        "resourcepacks"
    ],
    "projects": {
        "geckolib": {
            "side": "BOTH"
        },
        "athena": {
            "side": "BOTH"
        },
        "continuity": {
            "update_strategy": "NONE"
        },
        "puddles-floods": {
            "side": "CLIENT"
        },
        "blended-compat": {
            "redistributable": true
        },
        "explosive-enhancement": {
            "update_strategy": "NONE"
        },
        "chunk-sending-forge-fabric": {
            "side": "SERVER"
        }
    },
    "export_server_side_projects_to_client": true
}
